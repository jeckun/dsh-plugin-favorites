{
  "name": "dsh-plugin-favorites",
  "version": "1.0.0",
  "author": "Jeckun",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "A right-sidebar favorites manager for DeepSeek Harness with categories, drag-and-drop, and link editing.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeckun/dsh-plugin-favorites.git"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
